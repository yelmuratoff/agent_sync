#!/usr/bin/env bash
#
# strip-ai-chars: deterministic typographic cleanup.
#
# Removes:
#   1. Invisible / zero-width / bidi-formatting characters, including the
#      tag-character range (U+E0020-U+E007F) used for steganographic AI
#      watermarks, and Cf-class control characters.
#   2. Decorative Unicode symbols that are not typeable on any standard
#      keyboard layout: math alphanumeric letters (the main "fake bold"
#      AI tell, like 𝐛𝐨𝐥𝐝, 𝑖𝑡𝑎𝑙𝑖𝑐, 𝟙𝟚𝟛), math operators (∀ ∃ ∑ ∫),
#      arrows (← → ↑ ↓), supplemental arrows, box drawing (┌ ─ │),
#      block elements (▀ █ ░), control pictures, OCR symbols, enclosed
#      alphanumerics (① Ⓐ), and supplemental math symbols.
#   3. Curly quotes (" " „ « »), curly single quotes (' ' ʼ), em / en /
#      horizontal-bar dashes (— – ―), and ellipsis (…), normalised to
#      ASCII equivalents.
#   4. Non-breaking spaces (U+00A0) converted to regular spaces.
#   5. Trailing whitespace at the end of every line.
#
# Preserves:
#   - All natural-language letters and marks from every script (Latin,
#     Cyrillic, Greek, Arabic, CJK, Devanagari, Thai, Hebrew, etc.).
#   - Digits and numeric forms.
#   - All ASCII punctuation typeable on a keyboard.
#   - Currency symbols.
#   - Emoji (U+1F300 and beyond).
#   - Common dingbats, geometric shapes, and miscellaneous symbols that
#     are reachable through OS emoji keyboards (♥ ♪ ★ ✓ ✗ ▶ ◆).
#   - Letterlike block (™ № ℃ ℉) and miscellaneous technical (⌘ ⏎ ⌛).
#
# Does not alter wording, sentence structure, or meaning.
#
# Reads stdin, writes stdout.
#
#   bash strip-ai-chars < input.txt > clean.txt
#   pbpaste | bash strip-ai-chars | pbcopy
#
# Requires perl, which ships with macOS, every Linux distribution, and
# Git Bash on Windows.
#
# Default transformations ported from https://github.com/Nordth/humanize-ai-lib (MIT).
# Symbol stripping is a conservative reinterpretation of its keyboardOnly
# mode: it removes only what no keyboard layout produces, and never
# touches letters of any script.

set -euo pipefail

exec perl -CSDA -pe '
  # Invisible / zero-width / bidi-formatting / tag chars (watermarks).
  # Covers every Unicode Cf-category character through Unicode 15.x, plus
  # selected C0/C1 controls. Tag-character range U+E0020-U+E007F is the
  # most common steganographic-watermark vector.
  s/[\x{0000}-\x{0008}\x{000E}-\x{001B}\x{007F}-\x{009F}\x{00AD}\x{0600}-\x{0605}\x{061C}\x{06DD}\x{070F}\x{0890}-\x{0891}\x{08E2}\x{180E}\x{200B}-\x{200F}\x{202A}-\x{202E}\x{2060}-\x{2064}\x{2066}-\x{206F}\x{FEFF}\x{FFF9}-\x{FFFB}\x{110BD}\x{110CD}\x{13430}-\x{13438}\x{1BCA0}-\x{1BCA3}\x{1D173}-\x{1D17A}\x{E0001}\x{E0020}-\x{E007F}]//g;
  # Decorative symbols not produced by any standard keyboard.
  # Includes the dingbat-arrow / dingbat-circled-digit / ornamental-bracket
  # subrange (U+2768-U+27BE) which AI often uses as fake bullets, while
  # preserving the rest of Dingbats (check, cross, star, heart, mail, etc.).
  s/[\x{2190}-\x{21FF}\x{2200}-\x{22FF}\x{2400}-\x{243F}\x{2440}-\x{245F}\x{2460}-\x{24FF}\x{2500}-\x{257F}\x{2580}-\x{259F}\x{2768}-\x{27BE}\x{27C0}-\x{27EF}\x{27F0}-\x{27FF}\x{2900}-\x{297F}\x{2980}-\x{29FF}\x{2A00}-\x{2AFF}\x{2B00}-\x{2BFF}\x{1D400}-\x{1D7FF}]//g;
  # Non-breaking space -> regular space
  s/\x{00A0}/ /g;
  # Em dash, en dash, horizontal bar -> hyphen
  s/[\x{2013}\x{2014}\x{2015}]/-/g;
  # Curly double quotes and guillemets -> straight double quote
  s/[\x{201C}\x{201D}\x{201E}\x{00AB}\x{00BB}]/"/g;
  # Curly single quotes and modifier apostrophe -> straight apostrophe
  s/[\x{2018}\x{2019}\x{02BC}]/\x27/g;
  # Ellipsis -> three dots
  s/\x{2026}/.../g;
  # Trailing whitespace on each line
  s/[ \t\x0B\f]+$//;
'
