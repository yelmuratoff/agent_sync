{
   "$schema": "https://json.schemastore.org/claude-code-settings.json",
   "includeCoAuthoredBy": false,
   "permissions": {
      "defaultMode": "default",
      "allow": [
         "Bash(git status)",
         "Bash(git diff *)",
         "Bash(git log *)",
         "Bash(git blame *)",
         "Bash(shellcheck *)",
         "Bash(bats *)",
         "Bash(bash -x *)",
         "Bash(ls *)",
         "Bash(cat VERSION)",
         "Read",
         "Write",
         "Edit"
      ],
      "ask": [
         "Bash(git push *)",
         "Bash(git reset --hard *)",
         "Bash(git rebase *)",
         "Bash(./install.sh *)"
      ],
      "deny": [
         "Bash(rm -rf *)",
         "Bash(curl *)",
         "Bash(wget *)",
         "Read(.env)",
         "Read(.env.*)",
         "Read(**/secrets/**)",
         "Read(**/*.pem)",
         "Read(**/id_rsa*)"
      ]
   }
}
